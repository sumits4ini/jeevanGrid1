{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DistressReportSchema",
  "description": "Schema representing public and field emergency distress messages",
  "type": "object",
  "required": ["id", "disaster_id", "latitude", "longitude", "raw_message", "triage_priority", "victims_count", "reported_at"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "disaster_id": { "type": "string", "format": "uuid" },
    "latitude": { "type": "number", "minimum": -90.0, "maximum": 90.0 },
    "longitude": { "type": "number", "minimum": -180.0, "maximum": 180.0 },
    "raw_message": { "type": "string", "minLength": 3 },
    "triage_priority": {
      "type": "string",
      "enum": ["P1_CRITICAL", "P2_HIGH", "P3_MEDIUM", "P4_LOW"]
    },
    "victims_count": { "type": "integer", "minimum": 1 },
    "verification_status": {
      "type": "string",
      "enum": ["UNVERIFIED", "VERIFIED_AI", "VERIFIED_OFFICER", "RESOLVED", "FALSE_ALARM"]
    },
    "reported_at": { "type": "string", "format": "date-time" }
  }
}
