# ==============================================================================
# JeevanGrid - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your local/prod secrets.
# NEVER commit actual secrets, API keys, or database credentials to git.
# ==============================================================================

# Application Configuration
APP_NAME="JeevanGrid Disaster Intelligence Platform"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-super-secret-hex-token-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Database (PostgreSQL + PostGIS)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jeevangrid_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jeevangrid_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jeevangrid_db

# Redis (Caching & Background Queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL=redis://localhost:6379/0

# External Disaster Telemetry APIs (Optional / Mock fallback available)
OPENWEATHER_API_KEY=your_openweather_api_key_here
IMD_API_KEY=your_imd_api_token_here
GDACS_FEED_URL=https://www.gdacs.org/xml/rss.xml
USGS_EARTHQUAKE_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Simulation Mode (true = allows deterministic seed replay for SIH demos/drills)
ENABLE_DEMO_SIMULATION_MODE=true
DEFAULT_SIMULATION_SCENARIO=assam_brahmaputra_flood_2026

# AI / ML Inference Settings
ML_MODEL_REGISTRY_PATH=ai_ml/models/
USE_MOCK_ML_INFERENCE=false
ML_INFERENCE_DEVICE=cpu

# Frontend Configuration (Next.js / MapLibre)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000/api/v1/ws/operations
NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_or_mapbox_key_here
NEXT_PUBLIC_ENABLE_SIMULATION_CONTROLS=true
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LAT=26.2006
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LNG=92.9376
NEXT_PUBLIC_DEFAULT_MAP_ZOOM=8

# Real-Time Operations & Alerts Settings (Phase 8)
REALTIME_ENABLED=true
ALERT_DEDUPLICATION_WINDOW_SECONDS=300
REALTIME_HEARTBEAT_SECONDS=30
