# JeevanGrid Backend Environment Variables
APP_NAME="JeevanGrid Backend API"
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database & Cache
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jeevangrid_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jeevangrid_db
REDIS_URL=redis://localhost:6379/0

# External Feeds & Simulation
ENABLE_DEMO_SIMULATION_MODE=true
DEFAULT_SIMULATION_SCENARIO=assam_brahmaputra_flood_2026
